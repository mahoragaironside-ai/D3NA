# Base de dados (Neon, Supabase, ou qualquer Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Autenticação
JWT_SECRET=troca-isto-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# IA (Anthropic) — nunca exponhas isto ao frontend
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Transcrição de áudio (Whisper via API da OpenAI)
OPENAI_API_KEY=sk-xxxxxxxx
STT_LANGUAGE=pt
# Abaixo deste nível de confiança, o sistema pede confirmação em vez de assumir a transcrição
STT_CONFIDENCE_THRESHOLD=0.55

# Verificação de telefone por SMS (via httpSMS — usa um telemóvel Android como gateway)
# Instala a app httpSMS no teu Android, liga-a à tua conta em https://httpsms.com,
# e usa o número desse telemóvel como HTTPSMS_FROM_NUMBER.
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=+244XXXXXXXXX

# Pagamento — Ref-X / FacilPay
PAYMENT_REFERENCE=276920618
PAYMENT_DESCRIPTION=Pagamento semanal
PAYMENT_URL=https://www.facipay.co.ao/app/referencia/276920618
PAYMENT_AMOUNT=600.00
PAYMENT_CURRENCY=AOA
# Chave simples para proteger a confirmação manual de pagamento (endpoint admin)
ADMIN_CONFIRM_KEY=troca-isto-tambem

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
